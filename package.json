{
  "name": "swipeclock-scripting",
  "displayName": "Swipeclock Scripting Language",
  "description": "Syntax highlighting and IntelliSense support for Swipeclock scripting language",
  "publisher": "JeremyFail",
  "repository": {
    "type": "git",
    "url": "https://github.com/JeremyFail/swipeclock-scripting-extension"
  },
  "license": "MIT",
  "author": "JeremyFail",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "swipeclock",
        "aliases": [
          "Swipeclock Scripting",
          "TimeWorksPlus",
          "TWP",
          "twp",
          "WorkforceHub",
          "WFHub",
          "WFH",
          "wfh"
        ],
        "extensions": [
          ".twp",
          ".twpscript",
          ".swipeclock",
          ".scscript",
          ".wfhscript",
          ".wfhub",
          ".workforcehub",
          ".timeworksplus"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "swipeclock",
        "scopeName": "source.swipeclock",
        "path": "./syntaxes/swipeclock.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "swipeclock",
        "scopes": {
          "variable": ["variable.other", "variable.other.readwrite"],
          "property": ["variable.other.property"],
          "variable.readonly": ["variable.other.property.invalid"],
          "class": ["storage.type"],
          "function": ["entity.name.function"]
        }
      }
    ],
    "configurationDefaults": {
      "[swipeclock]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.defaultFormatter": "swipeclock-scripting"
      }
    },
    "configuration": {
      "title": "Swipeclock Scripting",
      "properties": {
        "swipeclock.formatting.indentSize": {
          "type": "number",
          "default": 4,
          "description": "Number of spaces for indentation when using spaces (ignored when editor uses tabs)"
        },
        "swipeclock.formatting.braceStyle": {
          "type": "string",
          "enum": ["javascript", "allman"],
          "default": "javascript",
          "description": "Brace style: 'javascript' = opening brace on same line as if/else; 'allman' = opening brace on new line"
        },
        "swipeclock.warnExtendedFields": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings for extended fields (home4-9, department1-9, location1-9, payrate1-9) that require account settings to be enabled"
        }
      }
    },
    "commands": [
      {
        "command": "swipeclock.setupCursorRules",
        "title": "Swipeclock: Set Up Cursor AI Support",
        "category": "Swipeclock"
      },
      {
        "command": "swipeclock.setupCopilotInstructions",
        "title": "Swipeclock: Set Up GitHub Copilot Support",
        "category": "Swipeclock"
      },
      {
        "command": "swipeclock.setupAllAI",
        "title": "Swipeclock: Set Up All AI Support (Cursor & Copilot)",
        "category": "Swipeclock"
      }
    ]
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.0"
  }
}
